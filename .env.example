# Sao chép file này thành .env rồi điền giá trị local.
# Gmail: bật 2FA, tạo App Password, host smtp.gmail.com, port 587.
# Production secrets: đặt trên Vercel (không commit .env).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@minipouch.vn
SMTP_PASS=your-app-password
MAIL_FROM=hello@minipouch.vn
MAIL_TO=hello@minipouch.vn

# Trang quản trị /quan-tri — đặt đúng tên biến này trên Vercel.
admin_acc=
admin_pass=

# Postgres URI. Preferred over discrete DB_* when set.
# Local: existing host Postgres (do not create a new container for this app).
SERVICE_URL=postgres://postgres:postgres@127.0.0.1:5432/minipouch?sslmode=disable
# Production (Vercel / Aiven):
# SERVICE_URL=postgres://USER:PASS@HOST:PORT/defaultdb?sslmode=require

# Optional discrete fields (fallback / extras). Production may also set these.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=minipouch
DB_SSL_MODE=disable
DB_CONNECTION_LIMIT=10
# Keep false — schema only via SQL migrations (`npm run db:migrate`).
DB_SYNC=false
# Aiven CA certificate in PEM form (-----BEGIN CERTIFICATE----- … -----END CERTIFICATE-----).
# Paste the full file contents into Vercel DB_CA_CERT (newlines or \n both OK).
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Lưu sản phẩm / ảnh: Storage → Blob trên Vercel, rồi:
#   npx vercel link && npx vercel env pull .env --environment=development
# Local dùng OIDC: BLOB_STORE_ID + VERCEL_OIDC_TOKEN (SDK tự đọc).
# BLOB_STORE_ID = store private (catalog JSON)
# IMAGES_STORE_ID = store public (ảnh sản phẩm)
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# IMAGES_STORE_ID=
