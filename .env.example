# Sao chép file này thành .env.local rồi điền thông tin SMTP.
# Gmail: bật 2FA, tạo App Password, host smtp.gmail.com, port 587.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@minipouch.vn
SMTP_PASS=your-app-password
MAIL_FROM=hello@minipouch.vn
MAIL_TO=hello@minipouch.vn

# Trang quản trị /quan-tri — đặt đúng tên biến này trên Vercel.
admin_acc=
admin_pass=

# Lưu sản phẩm / ảnh: Storage → Blob trên Vercel, rồi:
#   npx vercel link && npx vercel env pull .env.local
# Local dùng OIDC: BLOB_STORE_ID + VERCEL_OIDC_TOKEN (SDK tự đọc).
# BLOB_STORE_ID = store private (catalog JSON)
# IMAGES_STORE_ID = store public (ảnh sản phẩm)
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# IMAGES_STORE_ID=
