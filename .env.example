# Sao chép file này thành .env.local rồi điền thông tin SMTP.
# Gmail: bật 2FA, tạo App Password, host smtp.gmail.com, port 587.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@minipouch.vn
SMTP_PASS=your-app-password
MAIL_FROM=hello@minipouch.vn
MAIL_TO=hello@minipouch.vn

# Trang quản trị /quan-tri — đặt đúng tên biến này trên Vercel.
admin_acc=
admin_pass=

# Lưu sản phẩm khi deploy: trong project Vercel, tạo Storage → Blob.
# Vercel tự thêm BLOB_READ_WRITE_TOKEN. Không có token thì trang quản trị không lưu được trên server.
# BLOB_READ_WRITE_TOKEN=
